# Copy this file to .env and edit values before running in production
PORT=3000

# Bind address. Loopback by default: the site is published through a cloudflared
# tunnel, which reaches the app over localhost, so there is no reason for port
# 3000 to be reachable from the network. The rate limiter also trusts
# CF-Connecting-IP, which is only safe while Cloudflare is the only way in.
# Set 0.0.0.0 ONLY if something other than a local tunnel/proxy must reach it.
HOST=127.0.0.1

# REQUIRED. The process refuses to start without this, and refuses a value that is
# shorter than 32 characters or still one of the placeholders. Generate one with:
#   openssl rand -hex 32
# Changing it signs everybody out, which is the point after a suspected leak.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First-run admin account. Created ONLY when the database has no admin yet.
# There is deliberately no default password: leave ADMIN_PASSWORD empty and no
# admin is seeded at all (the old build fell back to a password printed in this
# file, which every unedited deployment then shipped with). Minimum 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Google OAuth (optional - "Login with Google" button is hidden/disabled if these are empty)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# GitHub OAuth (optional - "Đăng nhập với GitHub" button is hidden if these are empty)
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL must exactly match GITHUB_CALLBACK_URL below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/github/callback

# ---------------------------------------------------------------------------
# Email (OPTIONAL here - prefer the admin panel)
#
# Outgoing mail is now configured in the UI: Bảng quản trị > Cài đặt email.
# There you pick Gmail / Office 365 / a custom SMTP server, set the account and
# app password, and switch the OTP and new-post-notification emails on or off.
# Those values are stored in the database and always take precedence.
#
# The three variables below are only a FALLBACK, kept so an existing deployment
# configured this way keeps working. Each one is used only while the matching
# field in the admin panel is left empty.
# ---------------------------------------------------------------------------

# SMTP account. For Gmail: an App Password from
# https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# For Office 365: an App Password, plus Authenticated SMTP enabled on the mailbox.
SMTP_USER=
SMTP_APP_PASSWORD=

# Full public domain (no trailing slash) - used to build clickable links in
# new-post notification emails. Without it those links are broken.
SITE_URL=https://your-domain.com
